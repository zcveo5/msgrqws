#$#$SERcode&@import json&@import os&@import shutil&@import tkinter as tk_&@from tkinter import ttk&@from tkinter.messagebox import showerror&@import data.lib.ui as btaeui&@&@glb_msgr = None&@settings_orig = None&@SettingsModClass = None&@side = None&@&@root_path_plug = os.path.dirname(__file__).replace('\\'[0:1], '/')&@&@class Plugin:&@%TAB@staticmethod&@%TABdef give_data(app):&@%TAB%TABglobal glb_msgr, SettingsModClass, side&@%TAB%TABglb_msgr = app&@&@%TAB%TABclass SettingsMod(glb_msgr.Settings):&@%TAB%TAB%TABdef __init__(self, **kwargs):&@%TAB%TAB%TAB%TABsuper().__init__(**kwargs)&@%TAB%TAB%TAB%TABself._base_widgets.append(btaeui.Button(self._o, text='Multi NC Menu',&@%TAB%TAB%TAB%TAB%TAB%TAB%TAB%TAB%TAB  command=nc_menu, bg=glb_msgr.default_bg,&@%TAB%TAB%TAB%TAB%TAB%TAB%TAB%TAB%TAB  fg=glb_msgr.default_fg, font=glb_msgr.font_theme))&@&@%TAB%TAB%TAB#def _create_base(self):&@%TAB%TAB%TAB#%TABsuper()._create_base()&@%TAB%TAB%TAB#%TABself.create(btaeui.Button(self._o, text='Multi NC Menu',&@%TAB%TAB%TAB#%TAB%TAB%TAB%TAB%TAB%TAB  command=nc_menu, bg=glb_msgr.default_bg,&@%TAB%TAB%TAB#%TAB%TAB%TAB%TAB%TAB%TAB  fg=glb_msgr.default_fg, font=glb_msgr.font_theme),&@%TAB%TAB%TAB#%TAB%TAB%TAB%TABx=5, y=165, anchor='w')&@&@%TAB%TABSettingsModClass = SettingsMod&@%TAB%TABside = Side(glb_msgr.movable_lbl, [glb_msgr.default_bg, glb_msgr.default_fg, ':'.join(glb_msgr.font_theme)], title='Multi NC Menu')&@&@%TAB@staticmethod&@%TABdef execute():&@%TAB%TABmain()&@&@def create_instance(name):&@%TABif os.path.exists(f'{root_path_plug}/ncs/{name}.nc'):&@%TAB%TABshowerror('Error', f'Instance with name {name} already exists')&@%TAB%TABreturn&@%TABwith open(f'{root_path_plug}/ncs/{name}.nc', 'w'):&@%TAB%TABpass&@&@def create_instance_ui():&@%TABwin = tk_.Tk()&@%TABname = btaeui.Entry(win)&@%TABname.pack()&@%TABbtaeui.Button(win, text='Confirm', command=lambda: create_instance(name.get())).pack()&@&@def find_nc():&@%TABfor file in os.listdir('./data'):&@%TAB%TABif os.path.isfile(f'./data/{file}') and len(file.split('.')) > 1:&@%TAB%TAB%TABif file.split('.')[1].lower() == 'nc':&@%TAB%TAB%TAB%TABreturn file&@%TABreturn None&@&@&@def load_instance(event):&@%TABprint(f'loading instance {event.widget.get()}')&@%TABglb_msgr.dump_data_nc()&@%TABto_load = f'{root_path_plug}/ncs/{event.widget.get()}'&@%TABnc_current = f'./data/{find_nc()}'&@%TABnc_current_fn = find_nc()&@%TABshutil.move(to_load, f'./data/{event.widget.get()}')&@%TABshutil.move(nc_current, f'{root_path_plug}/ncs/{nc_current_fn}')&@%TABglb_msgr.base_conf['LOAD_NC'] = event.widget.get()&@%TABglb_msgr.reload_data_nc()&@%TABglb_msgr.reinit_window()&@%TABi = glb_msgr.show('Warning', 'To prevent conflicts, you need to restart app.', custom_close=glb_msgr.main.quit, ret_win=True)&@%TABi.winfo_children()[0].destroy()&@%TABglb_msgr.backup_data_nc = False&@&@class Side(btaeui.SidePanelRevision):&@%TABdef _create_base(self):&@%TAB%TABself.create(btaeui.Label(), x=-100, y=-100, name='loaded')&@%TAB%TABvar = os.listdir(os.path.dirname(__file__).replace('\\'[0:1], '/') + '/ncs')&@%TAB%TABcb = ttk.Combobox(self._o, values=var)&@%TAB%TABprint(cb)&@%TAB%TABcb.bind('<<ComboboxSelected>>', load_instance)&@%TAB%TABcb.place(x=5, y=45, anchor='w')&@%TAB%TABself._widgets.append({'widget': cb})&@%TAB%TABself.create(btaeui.Button(text='Create Instance', command=create_instance_ui), x=5, y=70, anchor='w')&@%TAB%TABself.create(btaeui.Label(text=f'Current Instance: {glb_msgr.base_conf["LOAD_NC"]}'), x=5, y=100, anchor='w')&@&@%TABdef build(self):&@%TAB%TABself.destroy()&@%TAB%TABsuper().build()&@%TAB%TABself._create_base()&@&@&@&@&@def main():&@%TABglobal settings_orig&@%TABsettings_orig = glb_msgr.Settings()&@%TABglb_msgr.Settings = SettingsModClass&@&@&@def nc_menu():&@%TABside.build()&@&@#$#$SERclass&@Plugin&@#$#$SERname&@multi.nc&@